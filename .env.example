# Application Environment
APP_ENV=development
APP_NAME="AvocaScan AI Service"
APP_VERSION="1.0.0"
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security & Authentication
API_TOKEN=your_secure_api_token_here

# Model Paths
MODEL_STAGE1_PATH=models/stage1/best_model.pth
MODEL_STAGE1_CLASS_NAMES_PATH=models/stage1/class_names.json
MODEL_STAGE2_PATH=models/stage2/best_model.pth
MODEL_STAGE2_CLASS_NAMES_PATH=models/stage2/class_names.json

# Inference & Service Configuration
AI_SERVICE_TIMEOUT=30
MAX_FILE_SIZE=10485760

# Stage 1 Preprocessing (identik dengan training: Resize 224x224, tanpa crop)
STAGE1_RESIZE_HEIGHT=224
STAGE1_RESIZE_WIDTH=224

# Stage 2 Preprocessing (identik dengan training: Resize 256x256 lalu CenterCrop 224)
STAGE2_RESIZE_HEIGHT=256
STAGE2_RESIZE_WIDTH=256
STAGE2_CROP_SIZE=224

# ImageNet Normalization (digunakan oleh Stage 1 dan Stage 2)
# Jangan ubah nilai ini tanpa melatih ulang model
NORMALIZE_MEAN=[0.485,0.456,0.406]
NORMALIZE_STD=[0.229,0.224,0.225]
